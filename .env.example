NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://platform_app:CHANGE_ME@localhost:5432/platform
DATABASE_ADMIN_URL=postgres://platform_admin:CHANGE_ME@localhost:5432/platform
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_SECONDS=86400
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=60
RATE_LIMIT_AUTH=10
COOKIE_SECURE=false
LOG_LEVEL=info

# Base64-encoded 32-byte AES-256 key; keep the real value in a secret manager.
MFA_ENCRYPTION_KEY=
